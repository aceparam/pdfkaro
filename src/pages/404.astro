---
import Base from '../layouts/Base.astro';
import { siteName, withBase } from '../site';
---

<Base title={`Page not found - ${siteName}`} description="There is no page at this address.">
  <h1>Page not found</h1>
  <p>There is no page at this address. It may have been typed wrongly.</p>
  <p><a class="tap" href={withBase(import.meta.env.BASE_URL, '/')}>See the list of all tools</a></p>
</Base>
